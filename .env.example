# Unified State CCTV Surveillance Platform Environment Configuration
# Copy this to .env and configure for production deployments

ENVIRONMENT=production
EVAL_MODE=false

# PostgreSQL + PostGIS Configuration
DB_USER=cctv_admin
DB_PASSWORD=YOUR_STRONG_POSTGRES_PASSWORD_HERE
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cctv_unified_db

# Redis Event Bus
REDIS_URL=redis://localhost:6379/0

# Security & Secret Keys (Generate with: openssl rand -hex 32)
SECRET_KEY=YOUR_SECURE_JWT_SECRET_KEY_HERE
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Media Relay Ports
MEDIAMTX_HOST=localhost
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_HLS_PORT=8888
MEDIAMTX_WHEP_PORT=8889

# AI Pipeline Sizing
ANPR_WORKER_CONCURRENCY=8
ANPR_SAMPLE_FPS=1.5
ANPR_CONFIDENCE_THRESHOLD=0.70
